<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/multiViewRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0E">

    <!-- Top Action & Mode Bar -->
    <LinearLayout
        android:id="@+id/llTopBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_alignParentTop="true"
        android:background="#141722"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:elevation="6dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="#FFFFFF"
            android:focusable="true"
            android:contentDescription="Voltar" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="MULTIVIEW"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvActiveFeedsCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="#2038BDF8"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="0/4 FEEDS"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Mode Selectors: 2 Screens vs 4 Screens -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="#202432"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnMode2"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@android:color/transparent"
                android:text="2 Ecrãs"
                android:textColor="#9CA3AF"
                android:textSize="11sp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:focusable="true" />

            <Button
                android:id="@+id/btnMode4"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="#2563EB"
                android:text="4 Ecrãs"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:focusable="true" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnClearAll"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_delete"
            android:tint="#EF4444"
            android:focusable="true"
            android:contentDescription="Limpar Todos" />
    </LinearLayout>

    <!-- Grid Container for Slots -->
    <LinearLayout
        android:id="@+id/llGridContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/llTopBar"
        android:orientation="vertical"
        android:padding="3dp"
        android:background="#0A0A0E">

        <!-- Top Row (Slot 0 and Slot 1) -->
        <LinearLayout
            android:id="@+id/llRowTop"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/slot0Container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:background="#141722"
                android:focusable="true" />

            <FrameLayout
                android:id="@+id/slot1Container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:background="#141722"
                android:focusable="true" />
        </LinearLayout>

        <!-- Bottom Row (Slot 2 and Slot 3) - Visible in 4-Screen Mode -->
        <LinearLayout
            android:id="@+id/llRowBottom"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/slot2Container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:background="#141722"
                android:focusable="true" />

            <FrameLayout
                android:id="@+id/slot3Container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:background="#141722"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Fullscreen Container for Single Slot Expansion -->
    <FrameLayout
        android:id="@+id/flFullscreenSlotContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone"
        android:elevation="10dp" />

</RelativeLayout>
