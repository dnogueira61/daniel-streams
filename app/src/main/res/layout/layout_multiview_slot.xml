<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/slotRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#141722"
    android:focusable="true">

    <!-- Empty View with + Button -->
    <LinearLayout
        android:id="@+id/llEmptyView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#141722"
        android:clickable="true"
        android:focusable="true"
        android:padding="16dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_input_add"
            android:tint="#38BDF8"
            android:contentDescription="Adicionar" />

        <TextView
            android:id="@+id/tvEmptySlotTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="+ Adicionar Transmissão"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEmptySlotNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Ecrã 1"
            android:textColor="#9CA3AF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Active Stream Player Container -->
    <FrameLayout
        android:id="@+id/flActiveStream"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Scoped WebView -->
        <WebView
            android:id="@+id/slotWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000" />

        <!-- Overlay Header -->
        <LinearLayout
            android:id="@+id/llSlotOverlay"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_gravity="top"
            android:background="#CC0A0A0E"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="6dp">

            <TextView
                android:id="@+id/tvSlotTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Canal / Jogo"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAudioStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="#3338BDF8"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="🔊 ÁUDIO"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnSlotSwap"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_rotate"
                android:tint="#38BDF8"
                android:focusable="true"
                android:contentDescription="Trocar Jogo" />

            <ImageButton
                android:id="@+id/btnSlotAudio"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_lock_silent_mode_off"
                android:tint="#FFFFFF"
                android:focusable="true"
                android:contentDescription="Ativar Áudio" />

            <ImageButton
                android:id="@+id/btnSlotFullscreen"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_crop"
                android:tint="#FFFFFF"
                android:focusable="true"
                android:contentDescription="Ecrã Inteiro" />

            <ImageButton
                android:id="@+id/btnSlotClose"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="#EF4444"
                android:focusable="true"
                android:contentDescription="Remover" />
        </LinearLayout>
    </FrameLayout>

    <!-- Selection / Focus Border -->
    <View
        android:id="@+id/vFocusBorder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_slot_border_active"
        android:visibility="gone" />

</FrameLayout>
