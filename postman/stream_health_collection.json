{
	"info": {
		"_postman_id": "dlive-stream-health-suite-v1",
		"name": "DanielStreams - Stream & API Health Automation",
		"description": "Suite de validação automatizada de integridade das APIs e servidores de vídeo (DaddyLive, TimStreams, PPV/StreamFree)",
