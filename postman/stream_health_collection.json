	"item": [
		{
			"name": "1. DaddyLive Schedule Fallback JSON",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test('Response is valid JSON with day schedules', function () {",
							"    var data = pm.response.json();",
							"    pm.expect(Object.keys(data).length).to.be.above(0);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "User-Agent",
						"value": "Mozilla/5.0"
					},
					{
						"key": "Referer",
						"value": "https://thedaddy.pk/"
					}
				],
				"url": {
					"raw": "https://thedaddy.pk/schedule/schedule-generated.json",
					"protocol": "https",
					"host": ["thedaddy", "pk"],
					"path": ["schedule", "schedule-generated.json"]
				}
			}
		},
